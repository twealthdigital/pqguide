# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# RESEND_API_KEY: Server-side Resend API key for sending verification OTP emails.
RESEND_API_KEY=

# EMAIL_FROM: Sender address for verification emails.
EMAIL_FROM=PQGuide <onboarding@resend.dev>

# OTP_HMAC_SECRET: Server-side secret (>= 16 chars, recommended 32+ random hex/base64) for hashing OTPs.
OTP_HMAC_SECRET=

# UPSTASH_REDIS_REST_URL: Upstash Redis REST endpoint for persistent OTP & rate-limit state.
UPSTASH_REDIS_REST_URL=

# UPSTASH_REDIS_REST_TOKEN: Upstash Redis REST bearer token.
UPSTASH_REDIS_REST_TOKEN=
