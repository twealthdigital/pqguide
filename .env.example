# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# RESEND_API_KEY: Server-side Resend API key for sending verification OTP emails.
RESEND_API_KEY=

# EMAIL_FROM: Sender address for verification emails.
EMAIL_FROM=PQGuide <onboarding@resend.dev>

# OTP_HMAC_SECRET: Server-side secret (>= 16 chars, recommended 32+ random hex/base64) for hashing OTPs.
OTP_HMAC_SECRET=

# UPSTASH_REDIS_REST_URL: Upstash Redis REST endpoint for persistent OTP & rate-limit state.
UPSTASH_REDIS_REST_URL=

# UPSTASH_REDIS_REST_TOKEN: Upstash Redis REST bearer token.
UPSTASH_REDIS_REST_TOKEN=

# SUPER_ADMIN_SETUP_SECRET: One-time server authorization key (>= 16 chars) required to initialize the first production Super Admin.
SUPER_ADMIN_SETUP_SECRET=

# SUPER_ADMIN_BOOTSTRAP_EMAIL: Mandatory email allowlist for first-time production Super Admin initialization (receives mandatory init OTP).
SUPER_ADMIN_BOOTSTRAP_EMAIL=

# TOTP_ENCRYPTION_KEY: Dedicated server-side encryption key (>= 32 chars) used to AES-256-GCM encrypt Super Admin TOTP secrets at rest.
TOTP_ENCRYPTION_KEY=

# DOCUMENT_STORAGE_PROVIDER: Provider-independent storage adapter mode ('indexeddb' | 'memory' | 'object_storage').
DOCUMENT_STORAGE_PROVIDER=indexeddb

# DOCUMENT_SCAN_MAX_MB: Client/server maximum per-file upload cap in MB (default: 15).
DOCUMENT_SCAN_MAX_MB=15

# VISION_OCR_PROVIDER: Optional multimodal Vision OCR fallback provider ('gemini' | 'openai_compatible' | 'disabled').
# Uses GEMINI_API_KEY automatically when set to 'gemini' (or auto-detected).
VISION_OCR_PROVIDER=gemini

# VISION_OCR_MODEL: Model override for Vision OCR fallback (e.g. gemini-4-hydrogen or gpt-4o-mini).
VISION_OCR_MODEL=

# VISION_OCR_BASE_URL: Custom OpenAI-compatible Vision API base URL when VISION_OCR_PROVIDER=openai_compatible.
VISION_OCR_BASE_URL=

# VISION_OCR_API_KEY: Server-side API key for OpenAI-compatible Vision OCR providers (never exposed to browser).
VISION_OCR_API_KEY=

# SURYA_OCR_URL: HTTP URL of self-hosted Python Surya FastAPI microservice (e.g. http://127.0.0.1:8000).
SURYA_OCR_URL=

# DATALAB_API_KEY: Optional Datalab hosted Surya OCR API key (used if SURYA_OCR_URL is not set).
DATALAB_API_KEY=

# DATALAB_OCR_URL: Optional Datalab OCR endpoint override (default: https://www.datalab.to/api/v1/ocr).
DATALAB_OCR_URL=

# SURYA_TIMEOUT_MS: Request timeout in milliseconds for remote Surya inference calls (default: 45000).
SURYA_TIMEOUT_MS=45000

# HTR_SERVICE_URL: Optional dedicated TrOCR handwriting service endpoint (defaults to <SURYA_OCR_URL>/htr).
HTR_SERVICE_URL=

# OCR_INSTALLED_LANGUAGES: Comma-separated Tesseract traineddata codes installed locally (default auto-detects eng + yor).
OCR_INSTALLED_LANGUAGES=eng,yor
